{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {},
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.ellipog.tasked.fabric.TaskedFabric"
        ],
        "client": [
            "dev.ellipog.tasked.fabric.TaskedFabricClient"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "armature": ">=${armature_version}"
    },
    "suggests": {
        "emi": "*",
        "jei": "*",
        "roughlyenoughitems": "*"
    }
}
