{
  "$schema": "../tasked-quests.schema.json",

  "version": 1,

  "chapterGroups": [
    {
      "id": "getting_started",
      "title": "Getting Started",
      "chapters": [
        {
          "id": "first_steps",
          "title": "First Steps",
          "icon": { "item": "minecraft:crafting_table" },

          "quests": [
            {
              "id": "punch_a_tree",
              "title": "Punch a Tree",
              "description": [
                "Everything worth having starts with a tree,",
                "and everything worth having ends with you hitting it."
              ],
              "icon": { "item": "minecraft:oak_log" },
              "x": 0,
              "y": 0,

              "tasks": [
                { "type": "tasked:item", "item": "minecraft:oak_log", "count": 8 }
              ],
              "rewards": [
                { "type": "tasked:item", "item": "minecraft:wooden_axe", "count": 1 }
              ]
            },

            {
              "id": "make_a_table",
              "title": "Somewhere to Work",
              "subtitle": "A crafting table",
              "description": [
                "Four planks, a square, and suddenly you have options."
              ],
              "icon": { "item": "minecraft:crafting_table" },
              "x": 132,
              "y": 0,

              "dependsOn": ["punch_a_tree"],

              "tasks": [
                { "type": "tasked:item", "item": "minecraft:crafting_table", "count": 1 }
              ],
              "rewards": [
                { "type": "tasked:item", "item": "minecraft:stick", "count": 8 },
                { "type": "tasked:xp", "amount": 5 }
              ]
            },

            {
              "id": "stone_tools",
              "title": "Stone Tools",
              "icon": { "item": "minecraft:stone_pickaxe" },
              "x": 264,
              "y": 0,

              "dependsOn": ["make_a_table"],

              "tasks": [
                { "type": "tasked:item", "item": "minecraft:cobblestone", "count": 3 },
                { "type": "tasked:item", "item": "minecraft:stick", "count": 2 }
              ],
              "rewards": [
                { "type": "tasked:item", "item": "minecraft:stone_pickaxe", "count": 1 },
                { "type": "tasked:xp", "amount": 2, "levels": true }
              ]
            },

            {
              "id": "read_the_sign",
              "title": "Fine, I Read It",
              "subtitle": "Hand this one in yourself",
              "description": [
                "This one is not a puzzle.",
                "It is a button, and the button is a confession.",
                "It is also the only task in this chapter you hand in by hand --",
                "open it and press Submit. Everything else is counted as you carry it."
              ],
              "icon": { "item": "minecraft:oak_sign" },
              "x": 132,
              "y": 104,
              "shape": "circle",
              "repeatable": false,

              "dependsOn": ["punch_a_tree"],

              "tasks": [
                { "type": "tasked:checkmark", "title": "I have read the sign" }
              ],
              "rewards": [
                { "type": "tasked:xp", "amount": 1 }
              ]
            },

            {
              "id": "the_underground",
              "title": "Down There",
              "description": [
                "There is a whole other game below y=0,",
                "and none of it is pleased to see you."
              ],
              "icon": { "item": "minecraft:torch" },
              "x": 264,
              "y": 104,
              "shape": "hexagon",

              "dependsOn": ["stone_tools"],

              "tasks": [
                { "type": "tasked:item", "item": "minecraft:coal", "count": 16 }
              ],
              "rewards": [
                { "type": "tasked:item", "item": "minecraft:torch", "count": 32 }
              ]
            }
          ]
        }
      ]
    }
  ]
}
